# Dependencies
node_modules/

# Nuxt / Nitro build outputs
.nuxt/
.output/
dist/

# CMake build outputs
output/
build/

# 浏览器自动化工具的页面快照
.playwright-cli/

# Logs
*.log
*.txt
# 上面的 *.txt 本意是忽略日志，但会连 CMakeLists.txt 一起吞掉，
# 且 git add 对被忽略的文件静默跳过——新增的构建脚本会悄悄漏提交。
!CMakeLists.txt

# Environment files
.env
.env.*
!.env.example

# Firmware build artifacts
firmware/build/
firmware/build-gate/
firmware/build-msvc/

# State
mock_state/

# Superpowers SDD workspace (per-plan scratch: ledger, briefs, reports)
.superpowers/

# Go
*.exe
*.test

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/

# 打包/构建输出目录（如 firmware/docker/out、SDK 解包出的 out/）
# 注意：只匹配名为 out 的目录，不要写成 *out*——那会连 layouts/ 一起忽略掉
docker/out/
